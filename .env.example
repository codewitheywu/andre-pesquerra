# Copy to .env.local and fill in your values.

# Supabase → Project Settings → API Keys (use the publishable key, never the secret key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only (never NEXT_PUBLIC_): Supabase → Project Settings → API Keys →
# secret key. Lets the consulting form write inquiries through
# public.submit_inquiry. Without it the form says it is offline.
SUPABASE_SECRET_KEY=

# Public URL of the deployed site (used for canonical URLs, sitemap and OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
