Options -Indexes

# index.html exists only as a static snapshot for hosts (e.g. GitHub Pages)
# that can't execute PHP — on a real PHP host, index.php must still win.
DirectoryIndex index.php index.html

<FilesMatch "\.(sql|md|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Uncomment once TLS is configured on the production host:
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
